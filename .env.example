# Public base URL, used for share links and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string (Neon / Supabase / any Postgres).
# Leave unset in development to use the embedded PGlite database in ./.data
# DATABASE_URL=postgres://user:pass@host:5432/nyotanow

# Secret for the private /stats page: open /stats?key=THIS_VALUE
# Without it the page 404s for everyone.
# STATS_KEY=some-long-random-string
